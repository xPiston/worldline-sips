{
    "name": "xpiston/worldline-sips",
    "description": "Worldline Sips 2.0 (Sogenactif, Mercanet, Scellius, Sherlock's) for PHP, Laravel and Symfony: sealed Paypage requests, verified responses, capture, cancel and refund.",
    "keywords": [
        "sips",
        "worldline",
        "atos",
        "sogenactif",
        "mercanet",
        "scellius",
        "sherlocks",
        "payment",
        "laravel",
        "symfony",
        "3dsecure"
    ],
    "homepage": "https://github.com/xPiston/worldline-sips",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-hash": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "ext-curl": "*",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/pint": "^1.18",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "php-http/discovery": "^1.19",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "php-http/discovery": "Finds the PSR-18 client and PSR-17 factories on its own, so the Office services need no wiring.",
        "symfony/http-client": "A PSR-18 client for the Office services.",
        "guzzlehttp/guzzle": "A PSR-18 client for the Office services."
    },
    "autoload": {
        "psr-4": {
            "Piston\\Sips\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Piston\\Sips\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Piston\\Sips\\Bridge\\Laravel\\SipsServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "quality": [
            "@test:lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
